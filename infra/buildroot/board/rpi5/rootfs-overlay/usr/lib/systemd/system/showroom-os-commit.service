[Unit]
Description=Commit or roll back a Showroom OS update
# Not ordered after the agent or player: a start job that keeps restarting
# never finishes, which would keep a broken trial boot from ever rolling
# back. The script polls them instead.
After=local-fs.target
RequiresMountsFor=/data /var/lib/showroom

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/showroom/showroom-os-commit
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
