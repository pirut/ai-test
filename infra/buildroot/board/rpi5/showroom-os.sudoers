# Showroom OS: let the physical-console maintenance account run the self-test
# (it only reads) and inspect and test
# A/B OS updates. RAUC still refuses bundles not signed under the image's CA.
Cmnd_Alias SHOWROOM_OS = /usr/bin/rauc status, /usr/bin/rauc status *, /usr/libexec/showroom/showroom-os-install *, /usr/libexec/showroom/showroom-reboot, /usr/libexec/showroom/showroom-selftest, /usr/libexec/showroom/showroom-selftest *

showroom-maint ALL=(root) NOPASSWD: SHOWROOM_OS
