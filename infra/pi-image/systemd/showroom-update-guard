#!/bin/bash
set -euo pipefail

STATE_ROOT=/var/lib/showroom/state
PENDING="${STATE_ROOT}/pending-update.json"

[[ -f "${PENDING}" ]] || exit 0

healthy=0
for _ in $(seq 1 24); do
  if systemctl is-active --quiet showroom-agent.service \
    && systemctl is-active --quiet showroom-kiosk.service \
    && curl -fsS --max-time 2 'http://127.0.0.1:4173/healthz?deep=1' >/dev/null; then
    healthy=1
    break
  fi
  sleep 5
done

if [[ "${healthy}" == "1" ]]; then
  mv "${PENDING}" "${STATE_ROOT}/last-successful-update.json"
  exit 0
fi

python3 - "${PENDING}" <<'PY'
import json
import os
import sys

with open(sys.argv[1], "r", encoding="utf-8") as handle:
    pending = json.load(handle)

for kind in ("agent", "player"):
    previous = pending.get(kind, {}).get("previous")
    current_link = pending.get(kind, {}).get("currentLink")
    if not previous or not current_link:
        continue
    next_link = current_link + ".rollback"
    try:
        os.unlink(next_link)
    except FileNotFoundError:
        pass
    os.symlink(previous, next_link)
    os.replace(next_link, current_link)
PY

mv "${PENDING}" "${STATE_ROOT}/last-failed-update.json"
rollback_count="$(cat "${STATE_ROOT}/rollback-count" 2>/dev/null || echo 0)"
if [[ ! "${rollback_count}" =~ ^[0-9]+$ ]]; then rollback_count=0; fi
printf '%s\n' "$((rollback_count + 1))" > "${STATE_ROOT}/rollback-count.next"
mv "${STATE_ROOT}/rollback-count.next" "${STATE_ROOT}/rollback-count"
printf '%s\n' "application update health check failed" > "${STATE_ROOT}/last-boot-reason"
systemctl restart showroom-agent.service showroom-kiosk.service
exit 1
